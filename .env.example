# Development-only PostgreSQL settings; copy this file to .env to use them.
POSTGRES_USER=simple_siem
POSTGRES_PASSWORD=simple_siem
POSTGRES_DB=simple_siem

# Application settings. The Makefile assembles SIMPLE_SIEM_DATABASE_URL from
# the POSTGRES_* values above, so it is only documented here.
SIMPLE_SIEM_ENV=development
# SIMPLE_SIEM_DATABASE_URL=postgres://user:password@host:5432/db?sslmode=disable
# SIMPLE_SIEM_LISTEN=:8080
# SIMPLE_SIEM_PUBLIC_URL=http://localhost:8080
# SIMPLE_SIEM_TRUSTED_PROXIES=
# SIMPLE_SIEM_SHUTDOWN_TIMEOUT=30s
