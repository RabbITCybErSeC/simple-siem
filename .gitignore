# Local development environment and build output.
.env
bin/
.make/

# Planning and agent material stays local; the public repo holds product code
# and user documentation only.
.beads/
.claude/
docs/
openspec/
CLAUDE.md
AGENTS.md

# Beads / Dolt files (added by bd init).
.dolt/
*.db
.beads-credential-key

# Frontend dependencies and build output; only the .gitkeep is committed.
web/node_modules/
web/dist/*
!web/dist/.gitkeep

# Local agent configuration.
.mcp.json
